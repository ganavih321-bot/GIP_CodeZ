# PostgreSQL connection string (database is created automatically on startup)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PG_PASSWORD@localhost:5432/gip_codez

# Google Sign-In: OAuth 2.0 "Web application" Client ID.
# Add http://localhost:5173 to "Authorized JavaScript origins" in Google Cloud Console.
GOOGLE_CLIENT_ID=

# Comma-separated Google account emails that get the admin role
ADMIN_EMAILS=admin@example.com

# Change this in production
SECRET_KEY=change-me
